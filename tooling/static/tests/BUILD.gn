import("../../../test/test_helper.gni")
import("../../../toolchain.gni")

module_output_path = "toolchain/toolchain"

libarkinspector_test_sources = [
  "base64.cpp",
  "bigint_decimal_conversion_test.cpp",
  "debug_info_cache.cpp",
  "inspector_server.cpp",
  "json_object_matcher.cpp",
  "object_repository.cpp",
  "profiler_api_test.cpp",
  "session_manager.cpp",
  "source_manager.cpp",
  "thread_state.cpp",
]

ohos_source_set("arkinspector_tests_source") {
  testonly = true
  sources = libarkinspector_test_sources

  deps = [ "../:libarkinspector_plus_static" ]
  external_deps = [
    "bounds_checking_function:libsec_shared",
    "googletest:gmock",
    "googletest:gtest",
    "runtime_core:arktsdisassembler",
    "runtime_core:assembler_headers",
    "runtime_core:libarktsbase_package",
    "runtime_core:libpandabase_headers",
    "runtime_core:runtime_gen_headers",
    "runtime_core:runtime_headers",
  ]
  part_name = "toolchain"
  subsystem_name = "arkcompiler"
}

host_unittest_action("arkinspector_tests") {
  module_out_path = module_output_path
  deps = [
    "./:arkinspector_tests_source",
    "./async_stack_promise_test_abc:async_stack_promise_test_abc",
  ]

  external_deps = [
    "googletest:gtest",
    "googletest:gtest_main",
    "runtime_core:arktarget_options",
    "runtime_core:libarkruntime",
  ]
}
